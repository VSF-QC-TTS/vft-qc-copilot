# ==================================================
# Host ports
# ==================================================
VFQC_API_PORT=8080

# ==================================================
# PostgreSQL
# Database name and username are fixed as "vfqc" in compose.yaml.
# ==================================================
POSTGRES_PASSWORD=

# ==================================================
# Shared API <-> Runner authentication
# ==================================================
VFQC_RUNNER_TOKEN=

# ==================================================
# Application security
# ==================================================
JWT_SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_SALT=

# ==================================================
# Authentication and initial administrator
# ==================================================
VFQC_AUTH_REGISTRATION_MODE=ADMIN_ONLY
VFQC_ADMIN_EMAIL=admin@vfqc.local
VFQC_ADMIN_PASSWORD=
VFQC_ADMIN_DISPLAY_NAME=VFQC Administrator

# ==================================================
# Public application URLs
# Replace these with the real domains in production.
# ==================================================
WEB_BASE_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:8080

# ==================================================
# Database pool
# ==================================================
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ==================================================
# Spring AI / Gemini
# Use google-genai when Gemini should be enabled.
# Keep none when AI chat is disabled.
# ==================================================
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING_TEXT=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192

# ==================================================
# OAuth2
# ==================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==================================================
# Mail
# Keep disabled until a real SMTP server is configured.
# ==================================================
VFQC_MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
MAIL_FROM=no-reply@localhost

# ==================================================
# UI defaults
# ==================================================
DEFAULT_AVATAR_URL=https://ui-avatars.com/api/?name={name}&background=random&color=fff&size=128

# ==================================================
# Container resources
# ==================================================
API_MEMORY_LIMIT=2g
RUNNER_MEMORY_LIMIT=3g